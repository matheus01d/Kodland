import random
tamanho_senha = int(input('Qual Tamanho da senha? :\n'))
senha = 0
senha_rand = ''
aleatorio = "+-/*!&$#?=@abcdefghijklnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890"
while senha < tamanho_senha:
    senha = len(senha_rand)
    h = random.choice(aleatorio)
    senha_rand += h
print(senha_rand)
